# Copy this file to ".env" (same folder) and fill in what you have.
# Never commit .env or paste its contents anywhere public.

# --- Web server ---
PORT=4000

# --- Database ---
# Leave empty to use the built-in development database (stored in database/pgdata).
# To use a real PostgreSQL server later, set e.g.
# DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/af_factory
DATABASE_URL=

# --- Discord (leave empty to run the backend without the bot) ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
# Role allowed to submit requests. Empty = anyone in the server.
DISCORD_STAFF_ROLE_ID=
# Channel that receives staff notifications. Empty = no notifications.
DISCORD_STAFF_CHANNEL_ID=

# --- Later phases (not used yet) ---
ANTHROPIC_API_KEY=
MESHY_API_KEY=
